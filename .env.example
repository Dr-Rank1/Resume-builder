# ============================================
# AI RESUME BUILDER - ENVIRONMENT VARIABLES
# ============================================

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/resume_creator"

# ============================================
# AUTHENTICATION (NextAuth.js)
# ============================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-here-generate-with-openssl-rand-base64-32"

# Optional: Auth0 (if using Auth0 provider)
# AUTH0_CLIENT_ID=""
# AUTH0_CLIENT_SECRET=""
# AUTH0_ISSUER=""

# ============================================
# OPENAI (AI Engine)
# ============================================
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Optional: Azure OpenAI (alternative)
# AZURE_OPENAI_API_KEY=""
# AZURE_OPENAI_ENDPOINT=""
# AZURE_OPENAI_DEPLOYMENT_NAME=""

# ============================================
# STRIPE (Payments & Billing)
# ============================================
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_PRO_PRICE_ID="price_your_pro_price_id"
STRIPE_PREMIUM_PRICE_ID="price_your_premium_price_id"

# ============================================
# STORAGE (S3/Cloudflare R2)
# ============================================
# For file uploads and resume exports
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="resume-creator-uploads"
AWS_REGION="us-east-1"
AWS_S3_ENDPOINT="" # Optional: for S3-compatible services like R2

# ============================================
# REDIS (Caching - Optional but recommended)
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# SENTRY (Error Tracking - Optional)
# ============================================
SENTRY_DSN="https://your-sentry-dsn@host/project-id"

# ============================================
# POSTHOG (Analytics - Optional)
# ============================================
NEXT_PUBLIC_POSTHOG_KEY="phc_your_posthog_key"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ============================================
# APPLICATION URLs
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AI Resume Builder"

# ============================================
# RATE LIMITING
# ============================================
# AI API rate limits per tier
RATE_LIMIT_FREE_PER_MINUTE="2"
RATE_LIMIT_FREE_PER_DAY="10"
RATE_LIMIT_PRO_PER_MINUTE="10"
RATE_LIMIT_PRO_PER_DAY="100"
RATE_LIMIT_PREMIUM_PER_MINUTE="30"
RATE_LIMIT_PREMIUM_PER_DAY="500"

# ============================================
# AI CONFIGURATION
# ============================================
# Default AI model (gpt-4o-mini is most cost-effective)
AI_DEFAULT_MODEL="gpt-4o-mini"

# AI response cache TTL in seconds
AI_CACHE_TTL="900" # 15 minutes

# ============================================
# MULTI-TENANT CONFIGURATION
# ============================================
# Maximum organizations per deployment
MAX_ORGANIZATIONS="-1" # -1 for unlimited

# ============================================
# LOGGING & DEBUG
# ============================================
LOG_LEVEL="info" # debug, info, warn, error
DEBUG="false"